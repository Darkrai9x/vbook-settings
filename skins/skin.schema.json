{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Darkrai9x/vbook-settings/main/skins/skin.schema.json",
  "title": "vBook reader skin (skin.json)",
  "description": "See AGENTS.md for how each field is drawn. The app ignores unknown keys and skips layers it can't read.",
  "type": "object",
  "required": ["schema", "id", "name", "layers"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "minApp": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "author": { "type": "string" },
    "preview": { "$ref": "#/$defs/path" },
    "tokens": { "$ref": "#/$defs/tokens" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "tokens"],
        "properties": { "at": { "$ref": "#/$defs/hhmm" }, "tokens": { "$ref": "#/$defs/tokens" } },
        "additionalProperties": false
      }
    },
    "palettes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tokens"],
        "properties": { "when": { "$ref": "#/$defs/when" }, "tokens": { "$ref": "#/$defs/tokens" } },
        "additionalProperties": false
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "top": { "type": "integer", "minimum": 0, "default": 48 },
        "bottom": { "type": "integer", "minimum": 0, "default": 40 },
        "left": { "type": "integer", "minimum": 0, "default": 24 },
        "right": { "type": "integer", "minimum": 0, "default": 24 }
      },
      "additionalProperties": false
    },
    "imageSets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pattern", "count"],
        "properties": {
          "pattern": { "type": "string", "pattern": "\\{i(:\\d+)?\\}", "description": "Path with {i} or {i:2} (zero-padded)." },
          "count": { "type": "integer", "minimum": 1, "maximum": 128 }
        },
        "additionalProperties": false
      }
    },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "properties": { "en": { "type": "string" }, "vi": { "type": "string" } },
      "required": ["en"],
      "additionalProperties": { "type": "string" }
    },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^:]+$" },
    "hhmm": { "type": "string", "pattern": "^([01]?\\d|2[0-4]):[0-5]\\d$" },
    "colour": {
      "type": "string",
      "description": "#rrggbb, #rrggbbaa, or a token name; either optionally with @NN% opacity.",
      "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|[A-Za-z][A-Za-z0-9_]*)(@\\d{1,3}(\\.\\d+)?%)?$"
    },
    "tokens": { "type": "object", "additionalProperties": { "$ref": "#/$defs/colour" } },
    "expression": { "type": "string", "maxLength": 512 },
    "when": {
      "type": "object",
      "properties": {
        "pages": { "enum": ["first", "other"] },
        "dark": { "type": "boolean" },
        "time": { "type": "string", "pattern": "^([01]?\\d|2[0-4]):[0-5]\\d-([01]?\\d|2[0-4]):[0-5]\\d$" }
      },
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "properties": {
        "left": { "type": "number" }, "top": { "type": "number" }, "right": { "type": "number" },
        "bottom": { "type": "number" }, "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "common": {
      "type": "object",
      "properties": {
        "anchor": { "enum": ["page", "body", "top", "bottom"] },
        "rect": { "$ref": "#/$defs/rect" },
        "z": { "type": "integer" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["type"],
      "allOf": [{ "$ref": "#/$defs/common" }],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "image" },
            "src": { "$ref": "#/$defs/path" },
            "fit": { "enum": ["crop", "contain", "fill"] }
          },
          "required": ["src"]
        },
        {
          "properties": {
            "type": { "const": "set" },
            "set": { "type": "string" },
            "pick": { "$ref": "#/$defs/expression" },
            "count": { "type": "integer", "minimum": 1, "maximum": 32 },
            "gap": { "type": "number", "minimum": 0 },
            "highlight": { "type": ["integer", "null"], "minimum": 0 },
            "dim": { "type": "number", "minimum": 0, "maximum": 1 },
            "radius": { "type": "number", "minimum": 0 }
          },
          "required": ["set"]
        },
        {
          "properties": {
            "type": { "const": "text" },
            "value": { "type": "string", "description": "Template: literal text with {expression} parts." },
            "size": { "type": "number", "minimum": 4, "maximum": 96 },
            "color": { "$ref": "#/$defs/colour" },
            "align": { "enum": ["start", "center", "end"] },
            "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
            "italic": { "type": "boolean" },
            "font": { "enum": ["serif", "sans", "mono"] },
            "letterSpacing": { "type": "number" },
            "maxLines": { "type": "integer", "minimum": 1, "maximum": 8 }
          },
          "required": ["value"]
        },
        {
          "properties": {
            "type": { "const": "shape" },
            "shape": { "enum": ["rect", "line", "circle"] },
            "fill": { "$ref": "#/$defs/colour" },
            "fillEnd": { "$ref": "#/$defs/colour" },
            "stroke": { "$ref": "#/$defs/colour" },
            "strokeWidth": { "type": "number", "minimum": 0 },
            "radius": { "type": "number", "minimum": 0 },
            "progress": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "properties": {
            "type": { "const": "texture" },
            "texture": { "enum": ["paper", "do", "linen", "aged"] },
            "radius": { "type": "number", "minimum": 0 }
          }
        }
      ]
    }
  }
}
