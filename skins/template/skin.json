{
 "$schema": "../skin.schema.json",
 "schema": 1,
 "minApp": 1,
 "id": "template",
 "version": 1,
 "name": { "en": "Template", "vi": "Mẫu" },
 "description": { "en": "A calm paper page with a title header and a progress footer.", "vi": "Trang giấy dịu, tiêu đề trên, tiến độ dưới." },
 "author": "vBook",
 "preview": "preview.jpg",
 "tokens": {
  "background": "#f4efe4",
  "text": "#2a2420",
  "ink": "#2a2420",
  "accent": "#a0522d",
  "paper": "background",
  "muted": "ink@55%",
  "faint": "ink@14%"
 },
 "timeline": [
  { "at": "00:00", "tokens": { "background": "#1c1916", "text": "#e6dccb", "ink": "#e6dccb", "accent": "#d98a5c" } },
  { "at": "05:15", "tokens": { "background": "#1c1916", "text": "#e6dccb", "ink": "#e6dccb", "accent": "#d98a5c" } },
  { "at": "05:30", "tokens": { "background": "#f4efe4", "text": "#2a2420", "ink": "#2a2420", "accent": "#a0522d" } },
  { "at": "19:45", "tokens": { "background": "#f1e6d2", "text": "#2a2420", "ink": "#2a2420", "accent": "#a0522d" } },
  { "at": "20:00", "tokens": { "background": "#1c1916", "text": "#e6dccb", "ink": "#e6dccb", "accent": "#d98a5c" } }
 ],
 "palettes": [
  { "when": { "dark": true }, "tokens": { "background": "#1c1916", "text": "#e6dccb", "ink": "#e6dccb", "accent": "#d98a5c" } }
 ],
 "body": { "top": 100, "bottom": 64, "left": 30, "right": 30 },
 "layers": [
  { "type": "texture", "texture": "paper", "anchor": "page", "rect": {}, "opacity": 0.35, "z": -2, "when": { "dark": false, "time": "05:30-20:00" } },
  { "type": "texture", "texture": "paper", "anchor": "page", "rect": {}, "opacity": 0.12, "z": -2, "when": { "time": "20:00-05:30" } },
  { "type": "text", "value": "{upper(book.name)}", "anchor": "top", "rect": { "left": 28, "right": 28, "top": 22, "height": 14 }, "size": 8.5, "color": "accent", "letterSpacing": 2, "font": "serif" },
  { "type": "text", "value": "{chapter.title}", "anchor": "top", "rect": { "left": 28, "right": 28, "top": 40, "height": 26 }, "size": 16, "color": "ink", "weight": 600 },
  { "type": "shape", "anchor": "top", "rect": { "left": 28, "top": 74, "width": 48, "height": 2 }, "fill": "accent", "z": 1 },
  { "type": "shape", "anchor": "bottom", "rect": { "left": 30, "right": 30, "top": 16, "height": 1.5 }, "fill": "faint", "z": 1 },
  { "type": "shape", "anchor": "bottom", "rect": { "left": 30, "right": 30, "top": 16, "height": 1.5 }, "fill": "accent", "progress": "chapter.progress", "z": 1 },
  { "type": "text", "value": "{page.index} / {page.count}", "anchor": "bottom", "rect": { "top": 28, "width": 120, "height": 18 }, "size": 11, "color": "ink", "align": "center" },
  { "type": "text", "value": "{percent(book.progress)}", "anchor": "bottom", "rect": { "right": 30, "top": 30, "width": 90, "height": 14 }, "size": 9, "color": "muted", "align": "end" }
 ]
}
